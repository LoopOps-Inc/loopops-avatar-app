# HeyGen API key — https://app.heygen.com/api (Settings → API → New Key)
# Used by HeyGen CLI, video generation, and avatar management.
HEYGEN_API_KEY=

# Live Avatar API key — https://app.liveavatar.com (Developers page)
# Used by backend to mint session tokens (X-API-KEY header). Never ship in the mobile app.
HEYGEN_LIVE_AVATAR_API_KEY=

# Optional second HeyGen API key if your org uses separate keys per environment.
HEYGEN_DEVELOPER_API_KEY=
