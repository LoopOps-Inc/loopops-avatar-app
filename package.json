{
  "name": "loopops-avatar-app",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/web",
    "apps/native",
    "packages/contracts",
    "packages/eslint-config-native"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "check": "npm run check -w apps/web",
    "lint": "npm run lint -w apps/web",
    "format": "prettier --write .",
    "test": "npm run test -w apps/web",
    "test:native": "npm run test -w apps/native",
    "test:watch": "npm run test:watch -w apps/web",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "eslint": "^10.1.0"
  }
}
