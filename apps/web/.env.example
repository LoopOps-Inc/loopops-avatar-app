# Base URL for the agent backend (services/agent). Defaults to the /api dev proxy.
VITE_ADVISOR_API_BASE=

# Dev bearer token for the agent backend, minted with:
#   python services/agent/scripts/dev_token.py --client cl_demo_moderado --quiet
# Injected by the Vite/nginx proxy when the browser does not send Authorization.
# After the start screen mints POST /v1/auth/dev-token, that bearer is forwarded
# as-is so the session runs as the selected investor.
# Dev auth (repo-root .env). Vite mints a bearer token from DEV_SIGNING_KEY on each
# proxied /api request — no manual AGENT_DEV_TOKEN or Vite restart needed.
# Must match AUTH_DEV_SIGNING_KEY on the agent (docker compose reads DEV_SIGNING_KEY).
DEV_SIGNING_KEY=local-dev-signing-key-not-a-secret
AUTH_ACCESS_TOKEN_MAX_TTL_S=604800

# Optional override (usually leave empty; Vite mints from DEV_SIGNING_KEY instead):
# AGENT_DEV_TOKEN=
