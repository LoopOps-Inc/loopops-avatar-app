# LiveAvatar API key — https://app.liveavatar.com (Developers page)
# Dev-only: the Vite dev/preview proxy injects it as X-API-KEY, so it never
# reaches the client bundle. Production sessions must be minted by the backend.
LIVEAVATAR_API_KEY=

# Base URL for the LiveAvatar REST API (defaults to the dev proxy /liveavatar-api).
# Point at your backend in production.
VITE_LIVEAVATAR_API_BASE=

# HeyGen API key — https://app.heygen.com/api (Settings → API → New Key)
# Used by the HeyGen CLI, video generation, and avatar management.
HEYGEN_API_KEY=
