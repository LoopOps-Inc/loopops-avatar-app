# actinver-agent — local configuration. Copy to `.env` (`cp .env.example .env`).
#
# Every variable maps 1:1 to a field in src/actinver_agent/config.py
# (pydantic-settings; nested sections use the prefix shown in each header).
# Values shown are the local defaults, so an empty .env works.
#
# With Docker Compose only the variables referenced as ${VAR} in
# docker-compose.yml are read from this file (Compose substitution); the
# containers get their configuration from the compose `environment:` blocks.
# Real vendor keys for local testing go at the bottom (see README).
#
# RULE (docs/04-backend/01 §6, docs/05-security/04 §4): the environment carries
# secret REFERENCES, never secret VALUES. Every *_REF variable must be one of
#   secretsmanager://<name>   AWS Secrets Manager (floci locally)
#   kms://<name>              HMAC key material (Secrets Manager locally)
#   file://<path>             External Secrets Operator mount
#   env://<VAR>               local development only
# The process refuses to start if a *_REF holds a literal that looks like a key.

# ── Process ──────────────────────────────────────────────────────────────────
ENVIRONMENT=local                     # local | dev | staging | prod (posture validation)
SERVICE_NAME=agent-orchestrator       # OTel service.name
SERVICE_ROLE=agent                    # agent | suitability | guardrail | audit | transaction
LOG_LEVEL=INFO                        # DEBUG never in production
HOST=0.0.0.0
PORT=8443
PUBLIC_BASE_URL=http://localhost:8443
CORS_ORIGINS=["http://localhost:8080"]  # JSON list (the Vite dev server)

# ── Stores ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:local_only_not_a_secret@localhost:5432/actinver_agent
REDIS_URL=redis://localhost:6379/0
CACHE_PROVIDER=redis                  # redis | memory (memory = unit tests only)
CHECKPOINTER_PROVIDER=postgres        # postgres | memory (memory = unit tests only)

# ── Core systems (tool-gateway) ──────────────────────────────────────────────
CORE_PROVIDER=synthetic               # synthetic (deterministic demo core) | http (mTLS to Actinver core)
CORE_API_BASE_URL=https://core.internal.actinver.local
CORE_API_MTLS_CERT_PATH=/etc/certs/agent.crt
CORE_API_MTLS_KEY_PATH=/etc/certs/agent.key
CORE_API_CA_PATH=/etc/certs/actinver-ca.pem
MARKET_DATA_BASE_URL=https://marketdata.example.internal
NEWS_ALLOWLIST=["eleconomista.com.mx","elfinanciero.com.mx","reuters.com"]  # explicit hosts, no wildcards

# ── Observability (ADR-0016) ─────────────────────────────────────────────────
# http://localhost:4317 when the collector runs; empty = no export
OTLP_ENDPOINT=
# http://localhost:3000 with `--profile langfuse`
LANGFUSE_HOST=
CLIENT_HASH_SALT_REF=env://CLIENT_HASH_SALT   # reference; client_id appears in telemetry only as a salted hash

# ── Signing keys (references) ────────────────────────────────────────────────
FORM_SPEC_SIGNING_KEY_REF=kms://actinver/formspec-hmac        # agent-readable (ADR-0009)
SUITABILITY_SIGNING_KEY_REF=kms://actinver/suitability-hmac   # suitability-service ONLY; agent must not resolve it

# ── Prompts, rules, disclosure versions ──────────────────────────────────────
PROMPT_VERSION=advisor-es-MX@2026-08-20
PROMPTS_DIR=prompts
SUITABILITY_RULESET_VERSION=14
SERVICE_GUIDE_VERSION=2026-06
AI_DISCLOSURE_VERSION=2026-08
VOICE_RECORDING_DISCLOSURE_VERSION=2026-08

# ── AUTH_ (docs/05-security/03, ADR-0017) ────────────────────────────────────
AUTH_MODE=dev                         # dev (HS256, local only) | oidc (JWKS)
AUTH_ISSUER=https://idp.local.actinver/
AUTH_AUDIENCE=actinver-ai-advisor
# required when AUTH_MODE=oidc
AUTH_JWKS_URL=
AUTH_DEV_SIGNING_KEY_REF=env://AUTH_DEV_SIGNING_KEY   # reference (compose uses secretsmanager://actinver/dev-signing-key)
AUTH_DEV_PASSWORD=actinver123                          # shared local demo password
AUTH_DPOP_REQUIRED=false              # must be true outside local
AUTH_DPOP_CLOCK_SKEW_S=60
AUTH_DPOP_NONCE_TTL_S=300
AUTH_ACCESS_TOKEN_MAX_TTL_S=900

# ── LLM_ (ADR-0003) ──────────────────────────────────────────────────────────
LLM_PROVIDER=stub                     # stub (deterministic fallback) | vertex (prod) | gemini_api (local only)
# e.g. secretsmanager://actinver/gemini-api-key (local only)
LLM_GEMINI_API_KEY_REF=

# ── VERTEX_ ──────────────────────────────────────────────────────────────────
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL_FAST=gemini-2.5-flash
VERTEX_MODEL_DEEP=gemini-2.5-pro
VERTEX_TEMPERATURE=0.2
VERTEX_TOP_P=0.9
VERTEX_SEED=7
VERTEX_MAX_OUTPUT_TOKENS_VOICE=400
VERTEX_MAX_OUTPUT_TOKENS_CHAT=800
VERTEX_TIMEOUT_S=20.0

# ── LIVEAVATAR_ (ADR-0001, docs/01-architecture/05) ──────────────────────────
LIVEAVATAR_PROVIDER=stub              # stub (emulated vendor, no credits) | real (sandbox/prod API)
LIVEAVATAR_BASE_URL=https://api.liveavatar.com
LIVEAVATAR_API_KEY_REF=secretsmanager://actinver/liveavatar/api-key   # reference; X-API-KEY never leaves the backend
LIVEAVATAR_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a             # sandbox "Wayne"; Actinver avatar in prod
# empty in sandbox (catalog voices are rejected there)
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_IS_SANDBOX=true            # all local and CI work
LIVEAVATAR_MAX_SESSION_DURATION_S=1800
LIVEAVATAR_KEEP_ALIVE_INTERVAL_S=240
LIVEAVATAR_IDLE_PROMPT_S=90
LIVEAVATAR_IDLE_TEARDOWN_S=150
LIVEAVATAR_BACKGROUND_GRACE_S=30
LIVEAVATAR_MAX_CONCURRENT_SESSIONS=100  # below the contracted vendor ceiling
LIVEAVATAR_TOKEN_REFRESH_RATIO=0.8
LIVEAVATAR_AUDIO_SAMPLE_RATE_HZ=24000   # vendor contract: PCM s16le mono 24 kHz
LIVEAVATAR_AUDIO_SAMPLE_WIDTH_BYTES=2
LIVEAVATAR_AUDIO_CHANNELS=1
LIVEAVATAR_AUDIO_CHUNK_MS=1000
LIVEAVATAR_SPEAK_STARTED_TIMEOUT_S=2.0

# ── VOICE_ (ADR-0002) ────────────────────────────────────────────────────────
VOICE_PROVIDER=stub                   # stub (dev.transcript over the socket, silent TTS) | gemini_api (AI Studio TTS) | google
VOICE_STT_LANGUAGE=es-MX
VOICE_STT_MODEL=latest_long
VOICE_STT_MIN_CONFIDENCE=0.60
VOICE_STT_SAMPLE_RATE_HZ=16000
VOICE_GEMINI_TTS_VOICE=Puck
VOICE_TTS_VOICE_NAME=es-MX-Neural2-A
VOICE_TTS_SPEAKING_RATE=1.0
VOICE_TTS_SAMPLE_RATE_HZ=24000
VOICE_FILLER_THRESHOLD_MS=400
VOICE_THINKING_CEILING_S=8.0
VOICE_STUTTER_RESTART_WINDOW_S=1.5
VOICE_STT_PHRASE_HINTS=["Actinver","CETES","BIVA","BMV","TIIE","UDI","Banxico","renta variable","renta fija","fondo de inversión","casa de bolsa","estado de cuenta","rendimiento","portafolio","liquidez"]

# ── LIMITS_ (docs/01-architecture/06 §3.4, docs/04-backend/02 §2) ────────────
LIMITS_MAX_TOOL_ROUNDS=4
LIMITS_MAX_TOOL_CALLS_PER_TURN=10
LIMITS_TOOL_TIMEOUT_S=3.0
LIMITS_TOTAL_TOOL_BUDGET_S=8.0
LIMITS_MODEL_TIMEOUT_S=20.0
LIMITS_TURN_HARD_CEILING_S=30.0
LIMITS_MAX_REWRITE_ATTEMPTS=2
LIMITS_TURNS_PER_MINUTE=20
LIMITS_TURNS_PER_DAY=500
LIMITS_AVATAR_MINUTES_PER_DAY=60
LIMITS_MAX_MESSAGE_CHARS=2000
LIMITS_FORM_TTL_S=600
LIMITS_STEP_UP_CHALLENGE_TTL_S=120
LIMITS_IDEMPOTENCY_TTL_S=86400
LIMITS_THREAD_HISTORY_PAGE_SIZE=50

# ── SVC_ internal fail-closed dependencies (docs/04-backend/01 §2) ───────────
# "inprocess" runs the control as a library in this process (single-binary dev,
# tests). Compose sets http://suitability:8443 etc. so each runs separately.
SVC_SUITABILITY_URL=inprocess
SVC_GUARDRAIL_URL=inprocess
SVC_AUDIT_URL=inprocess
SVC_TRANSACTION_URL=inprocess
SVC_REQUEST_TIMEOUT_S=2.0
SVC_HEALTH_TIMEOUT_S=1.0

# ── OBJECT_STORE_ WORM tier (ADR-0012) — floci locally ───────────────────────
OBJECT_STORE_PROVIDER=s3              # s3 | memory (unit tests)
OBJECT_STORE_ENDPOINT=http://localhost:4566
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=actinver-evidence-local
OBJECT_STORE_LOCK_MODE=GOVERNANCE     # COMPLIANCE in prod
OBJECT_STORE_ACCESS_KEY_REF=env://AWS_ACCESS_KEY_ID
OBJECT_STORE_SECRET_KEY_REF=env://AWS_SECRET_ACCESS_KEY
OBJECT_STORE_RETENTION_YEARS=5

# ── SECRETS_ ─────────────────────────────────────────────────────────────────
SECRETS_MANAGER_ENDPOINT=http://localhost:4566
SECRETS_MANAGER_REGION=us-east-1
SECRETS_FILE_ROOT=/var/run/secrets/actinver

# ── Local-only literal values behind env:// references (never used outside local)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AUTH_DEV_SIGNING_KEY=local dev signing key - not a secret - change me
CLIENT_HASH_SALT=local telemetry salt - not a secret

# ── Core integrations (CORE_PROVIDER=http only; unused with synthetic) ────────
# Market data vendor API key: a secrets-manager reference, never the key itself.
MARKET_DATA_API_KEY_REF=secretsmanager://actinver/marketdata/api-key
# CRM (escalations, UNE complaints) base URL, reached over mTLS from the tool gateway.
CRM_BASE_URL=https://crm.internal.actinver.local
# Order management system base URL (transaction-service only).
OMS_BASE_URL=https://oms.internal.actinver.local
# News gateway (allow-listed hosts) and internal research corpus.
NEWS_SEARCH_BASE_URL=https://news-gateway.internal.actinver.local
RESEARCH_BASE_URL=https://research.actinver.com

# ── Real vendor keys for LOCAL testing (read by Compose, seeded into floci) ───
# Leave empty to run fully offline with the stubs. See README "Real vendor keys".
# AI Studio key -> `docker compose --profile gemini up -d agent-gemini` (port 8444)
GEMINI_API_KEY=
# HeyGen LiveAvatar sandbox key
LIVEAVATAR_API_KEY=
# LIVEAVATAR_PROVIDER=real            # uncomment to use the real vendor instead of the emulated one
# LIVEAVATAR_AVATAR_ID=               # override the sandbox avatar
# LIVEAVATAR_MAX_SESSION_DURATION_S=60  # sandbox accounts cap sessions (the broker also adapts to the vendor's cap)
# GOOGLE_APPLICATION_CREDENTIALS_IN_CONTAINER=/run/google/sa.json   # VOICE_PROVIDER=google needs a mounted service account
