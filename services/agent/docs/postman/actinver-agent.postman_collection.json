    {
      "name": "8. Compliance console (officer token)",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{officer_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "GET /v1/compliance/evidence?thread_id=",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Reason",
                "value": "revisión mensual (Postman)"
              }
            ],
            "url": "{{base_url}}/v1/compliance/evidence?thread_id={{thread_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('one record per turn', () => pm.expect(pm.response.json().items.length).to.be.above(0));",
                  "console.log(pm.response.json().items.map(i => [i.evidence_id, i.service_type, i.intent]));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/compliance/evidence/{{evidence_id}} (raw WORM record)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Reason",
                "value": "disputa 4711 (Postman)"
              }
            ],
            "url": "{{base_url}}/v1/compliance/evidence/{{evidence_id}}"
          }
        },
        {
          "name": "GET /v1/compliance/evidence/verify/{{thread_id}} (hash chain)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Reason",
                "value": "verificación trimestral (Postman)"
              }
            ],
            "url": "{{base_url}}/v1/compliance/evidence/verify/{{thread_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('chain intact', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/compliance/summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Reason",
                "value": "reporte (Postman)"
              }
            ],
            "url": "{{base_url}}/v1/compliance/summary?since=2026-01-01T00:00:00Z&until=2027-01-01T00:00:00Z"
          }
        },
        {
          "name": "GET /v1/compliance/flags",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Reason",
                "value": "revisión (Postman)"
              }
            ],
            "url": "{{base_url}}/v1/compliance/flags"
          }
        },
        {
          "name": "PUT kill switch ON (Risk authority)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{base_url}}/v1/compliance/flags/advisor.kill_switch",
            "body": {
              "mode": "raw",
              "raw": "{\"value\":\"on\",\"reason\":\"simulacro mensual\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('flipped', () => pm.response.to.have.status(200));",
                  "console.log('Now re-send a chat turn: it returns error KILL_SWITCH and GET /v1/config shows kill_switch=true. Then run the next request to turn it off.');"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT kill switch OFF",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{base_url}}/v1/compliance/flags/advisor.kill_switch",
            "body": {
              "mode": "raw",
              "raw": "{\"value\":\"off\",\"reason\":\"fin del simulacro\"}"
            }
          }
        },
        {
          "name": "POST /v1/compliance/arco (acceso: export with 90-day link)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Reason",
                "value": "solicitud ARCO (Postman)"
              }
            ],
            "url": "{{base_url}}/v1/compliance/arco",
            "body": {
              "mode": "raw",
              "raw": "{\"client_id\":\"cl_demo_moderado\",\"kind\":\"acceso\",\"reason\":\"solicitud del titular\"}"
            }
          }
        }
      ]
    }
  ]
}
