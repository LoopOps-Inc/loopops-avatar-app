  "components": {
    "schemas": {
      "DisclosureItem": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "text",
          "version"
        ],
        "title": "DisclosureItem"
      },
      "DisclosuresResponse": {
        "properties": {
          "items": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DisclosureItem"
            },
            "type": "object",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "DisclosuresResponse"
      },
      "GuardrailAction": {
        "type": "string",
        "enum": [
          "PASS",
          "REWRITE",
          "BLOCK"
        ],
        "title": "GuardrailAction"
      },
      "GuardrailVerdict": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/GuardrailAction"
          },
          "violations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Violations"
          },
          "redactions": {
            "type": "integer",
            "title": "Redactions",
            "default": 0
          },
          "injection_score": {
            "type": "number",
            "title": "Injection Score",
            "default": 0.0
          },
          "disclosures_injected": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Disclosures Injected"
          },
          "disclosure_versions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Disclosure Versions"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "GuardrailVerdict"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InputRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "title": "Text"
          },
          "transcript_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript Confidence"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "InputRequest"
      },
      "InputResponse": {
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/GuardrailVerdict"
          },
          "redacted_text": {
            "type": "string",
            "title": "Redacted Text"
          }
        },
        "type": "object",
        "required": [
          "verdict",
          "redacted_text"
        ],
        "title": "InputResponse"
      },
      "OutputRequest": {
        "properties": {
          "speech": {
            "type": "string",
            "maxLength": 20000,
            "title": "Speech"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "locale": {
            "type": "string",
            "title": "Locale",
            "default": "es-MX"
          },
          "register": {
            "type": "string",
            "title": "Register",
            "default": "tu"
          },
          "provenance_keys": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Provenance Keys"
          },
          "stripped_product_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Stripped Product Terms"
          },
          "rewrite_attempts": {
            "type": "integer",
            "title": "Rewrite Attempts",
            "default": 0
          },
          "max_rewrite_attempts": {
            "type": "integer",
            "title": "Max Rewrite Attempts",
            "default": 2
          },
          "sentence_mode": {
            "type": "boolean",
            "title": "Sentence Mode",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "speech"
        ],
        "title": "OutputRequest"
      },
      "ScanRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 200000,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ScanRequest"
      },
      "ScanResponse": {
        "properties": {
          "injection": {
            "type": "boolean",
            "title": "Injection"
          }
        },
        "type": "object",
        "required": [
          "injection"
        ],
        "title": "ScanResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}