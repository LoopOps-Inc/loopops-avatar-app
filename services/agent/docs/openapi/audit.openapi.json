  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerifyResponse": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "records": {
            "type": "integer",
            "title": "Records"
          },
          "first_divergent_evidence_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Divergent Evidence Id"
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "ok",
          "records",
          "first_divergent_evidence_id"
        ],
        "title": "VerifyResponse"
      },
      "WriteRequest": {
        "properties": {
          "record": {
            "additionalProperties": true,
            "type": "object",
            "title": "Record"
          },
          "fail_closed": {
            "type": "boolean",
            "title": "Fail Closed",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "record"
        ],
        "title": "WriteRequest"
      },
      "WriteResponse": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "spooled": {
            "type": "boolean",
            "title": "Spooled"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "content_hash",
          "spooled"
        ],
        "title": "WriteResponse"
      }
    }
  }
